      <mxGeometry height="154" width="330" y="26" as="geometry" />
    </mxCell>
    <mxCell id="execcol" parent="1" style="swimlane;fontStyle=1;startSize=26;html=1;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=default;" value="EXECUCAO_COLETA" vertex="1">
      <mxGeometry height="75" width="330" x="1900" y="220" as="geometry" />
    </mxCell>
    <mxCell id="execcol_b" parent="execcol" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;strokeColor=none;fillColor=none;" value="PK, FK execucao_id : bigint&#xa;PK, FK coleta_id : bigint" vertex="1">
      <mxGeometry height="49" width="330" y="26" as="geometry" />
    </mxCell>
    <mxCell id="iv" parent="1" style="swimlane;fontStyle=1;startSize=26;html=1;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=default;" value="INDICADOR_VALOR" vertex="1">
      <mxGeometry height="350" width="330" x="1900" y="335" as="geometry" />
    </mxCell>
    <mxCell id="iv_b" parent="iv" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;strokeColor=none;fillColor=none;" value="PK id : bigint&#xa;FK execucao_id : bigint&#xa;FK indicador_codigo, metodologia_versao&#xa;FK municipio_ibge : int (nullable em agregado de grupo)&#xa;FK grupo_pares_versao_id : int (nullable)&#xa;FK periodo_id : int&#xa;FK gestao_id : int (nullable, conforme regra de atribuição)&#xa;numerador : numeric&#xa;denominador : numeric (nullable)&#xa;valor : numeric&#xa;status_qualidade : varchar (completo | parcial | ausente | estimado)&#xa;cobertura : numeric(5,4) (fração de dados presentes)&#xa;publicado : boolean&#xa;UNIQUE (execucao_id, indicador_codigo, municipio_ibge, grupo_pares_versao_id, periodo_id)" vertex="1">
      <mxGeometry height="324" width="330" y="26" as="geometry" />
    </mxCell>
    <mxCell id="nota" parent="1" style="swimlane;fontStyle=1;startSize=26;html=1;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=default;" value="NOTA_SERIE (quebras e ressalvas)" vertex="1">
      <mxGeometry height="230" width="330" x="1900" y="725" as="geometry" />
    </mxCell>
    <mxCell id="nota_b" parent="nota" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;strokeColor=none;fillColor=none;" value="PK id : bigint&#xa;FK municipio_ibge : int (nullable = todos)&#xa;FK indicador_codigo : varchar (nullable)&#xa;metodologia_versao : int (nullable)&#xa;FK classificacao_id : int (nullable)&#xa;FK periodo_inicio_id : int&#xa;FK periodo_fim_id : int (nullable)&#xa;tipo : varchar (quebra | ressalva | contexto | correcao)&#xa;gravidade : varchar (informativa | impede_comparacao)&#xa;descricao : text&#xa;fundamento_url : varchar" vertex="1">
      <mxGeometry height="204" width="330" y="26" as="geometry" />
    </mxCell>
    <mxCell id="regras" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;size=14;" value="REGRAS DE CARGA E CONSULTA&#xa;&#xa;• Dados brutos sempre nominais e versionados: se o valor mudou, encerra a versão (valido_ate = now()) e insere nova. Nada é sobrescrito.&#xa;• Consulta as-of: valido_de ≤ data_corte e (valido_ate nulo ou valido_ate maior que data_corte).&#xa;• Unicidade DESPESA (PG15+): UNIQUE NULLS NOT DISTINCT (municipio_ibge, unidade_gestora_id, periodo_id, fonte_id, demonstrativo, nivel_detalhe, funcao_id, subfuncao_id, natureza_despesa_id, fonte_recurso_id, programa_codigo, acao_codigo, estagio) WHERE valido_ate IS NULL. RECEITA análogo.&#xa;• Nunca somar entre níveis de detalhe, entre demonstrativos, nem com a unidade &#39;consolidado&#39;.&#xa;• Indicadores excluem intraorçamentárias (despesa e receita) por padrão.&#xa;• Ausência ≠ zero: sem entrega em ENTREGA_DEMONSTRATIVO, o valor é &#39;ausente&#39;.&#xa;• Período parcial só se compara com o mesmo período acumulado de outro ano.&#xa;• FKs para CLASSIFICACAO_OFICIAL: FK composta (id, tipo) ou trigger que garanta o tipo correto.&#xa;• NOTA_SERIE com gravidade = impede_comparacao bloqueia a comparação no frontend.&#xa;• Atribuição à GESTAO segue regra_atribuicao_gestao (ex.: 1º ano executa a LOA do antecessor; RP herdados).&#xa;• RCL, DTP e mínimos constitucionais vêm de APURACAO_OFICIAL; não recalcular a partir de DESPESA." vertex="1">
      <mxGeometry height="560" width="330" y="740" as="geometry" />
    </mxCell>
    <mxCell id="legenda" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=14;" value="LEGENDA&#xa;Verde: referência (códigos oficiais, cadastros, tempo)&#xa;Azul: dado bruto, fiel à fonte&#xa;Cinza: proveniência e cobertura&#xa;Lilás: camada derivada&#xa;&#xa;FKs onipresentes (municipio_ibge, periodo_id, coleta_id, fonte_id) estão nos atributos, mas sem linhas, para não poluir o diagrama." vertex="1">
      <mxGeometry height="200" width="330" x="1900" y="995" as="geometry" />
    </mxCell>
